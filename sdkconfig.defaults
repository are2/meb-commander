# Keep automatic sleep disabled while USB-JTAG flashing/debugging is validated.
# CONFIG_BT_LE_SLEEP_ENABLE is not set
CONFIG_BT_LE_LP_CLK_SRC_MAIN_XTAL=y
# CONFIG_PM_ENABLE is not set
CONFIG_PM_POWER_DOWN_CPU_IN_LIGHT_SLEEP=y
# CONFIG_FREERTOS_USE_TICKLESS_IDLE is not set
# CONFIG_ESP_MODEM_CLOCK_ENABLE_CHECKING is not set

# Development builds keep crash diagnostics verbose. Production overrides these
# in sdkconfig.defaults.production.
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y
CONFIG_ESP_SYSTEM_PANIC_REBOOT_DELAY_SECONDS=10
# CONFIG_ESP_SYSTEM_NO_BACKTRACE is not set
# CONFIG_ESP_SYSTEM_USE_EH_FRAME is not set
CONFIG_ESP_SYSTEM_USE_FRAME_POINTER=y
# CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH is not set
CONFIG_ESP_COREDUMP_ENABLE_TO_UART=y
# CONFIG_ESP_COREDUMP_ENABLE_TO_NONE is not set
CONFIG_ESP_COREDUMP_UART_DELAY=0
CONFIG_ESP_COREDUMP_DECODE_INFO=y
